<svg width="120" height="120" viewBox="0 0 120 120" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="120" height="120" rx="28" fill="#07326F" />
  
  <!-- Energy Sparks in yellow -->
  <g transform="translate(4, -2)">
    <rect x="78" y="20" width="8" height="22" rx="4" transform="rotate(35 78 20)" fill="#F9D785" />
    <rect x="88" y="38" width="8" height="20" rx="4" transform="rotate(65 88 38)" fill="#F9D785" />
    <rect x="86" y="58" width="8" height="18" rx="4" transform="rotate(95 86 58)" fill="#F9D785" />
  </g>

  <!-- Smartphone body -->
  <rect x="36" y="22" width="44" height="76" rx="10" fill="#FFFFFF" />

  <!-- Phone Screen inner -->
  <rect x="41" y="30" width="34" height="55" rx="6" fill="#07326F" />

  <!-- Speaker grill -->
  <rect x="53" y="25.5" width="10" height="2.5" rx="1.25" fill="#07326F" />

  <!-- Home button -->
  <circle cx="58" cy="91.5" r="2.5" fill="#07326F" />

  <!-- Checkmark inside phone -->
  <path d="M48 57.5L54.5 64L68 47" stroke="#19AA83" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />

  <!-- Dynamic orbital swoosh arc -->
  <path d="M20 72C22 84 35 94 56 90C73 87 88 74 94 62C88 74 72 82 54 83C34 84 24 75 20 72Z" fill="#19AA83" />
  <path d="M18 69C16 77 24 88 44 92C62 95 80 84 94 63C82 78 62 86 42 84C26 82 19 74 18 69Z" fill="#19AA83" />
</svg>
